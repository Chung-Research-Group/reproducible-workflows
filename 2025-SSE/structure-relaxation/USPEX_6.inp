#----------------------------------Initialization---------------------------
units           metal
newton          on
dimension       3
boundary        p p p   # periodic boundary conditions (f ? aperiodic/ p - periodic)
atom_style 	atomic


pair_style    chgnet /home/khw/program/lammps_chgnet/potentials/CHGNET/
read_data     ./USPEX_6.data


pair_coeff    * *  0.3.0 Li P S Sb 

neighbor 2.0 bin
neigh_modify delay 1

neigh_modify 	every 1 delay 0 check yes  

compute 	_rg all gyration                
#---------------------------------------


min_style 	cg                                    # The algoritm of relaxation             
min_modify 	line backtrack                        # The parameters of minimzation algoritm 

fix 1 all npt temp 50 50 1 iso 1000 1000 1     # Cell relaxation, !!!!!!!USPEX use this to                                                                                       
dump 		1 all xyz 50 out.xyz                      # Record animation every 50 steps  

dump_modify     1 append yes

thermo_style  custom step time cpu pe ke etotal temp press vol density
thermo        1

#----------- geometry optimization----------------------

 
run 20000

write_data after_opt_USPEX_6.data
